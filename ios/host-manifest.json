{
  "app": {
    "bundleIdentifier": "com.smeltery.beam",
    "displayName": "Beam",
    "minimumOSVersion": "17.0",
    "entryPoint": "AppHost/BeamApp.swift",
    "requiredCapabilities": [
      "aps-environment"
    ],
    "entitlements": [
      "aps-environment"
    ],
    "usesPackageTypes": [
      "BeamAppHomeView",
      "BeamNotificationPermissionCoordinator",
      "BeamUserNotificationAuthorizer",
      "BeamUIApplicationRemoteNotificationRegistrar",
      "BeamAPNSTokenCoordinator",
      "BeamDeviceRegistrar"
    ]
  },
  "widgetExtension": {
    "bundleIdentifier": "com.smeltery.beam.widget",
    "displayName": "Beam Live Activity",
    "minimumOSVersion": "17.0",
    "entryPoint": "WidgetExtension/BeamLiveActivityWidget.swift",
    "requiredCapabilities": [
      "com.apple.developer.usernotifications.push-type.liveactivity"
    ],
    "entitlements": [
      "com.apple.developer.usernotifications.push-type.liveactivity"
    ],
    "usesPackageTypes": [
      "BeamActivityAttributes",
      "BeamActivityContentState",
      "BeamLiveActivityView",
      "BeamLiveActivityCompactView",
      "BeamLiveActivityMinimalView"
    ]
  }
}
